{
  "name": "soloips-profile",
  "version": "0.0.0",
  "private": true,
  "description": "SoloIPs DSH profile：以 dsh-base + dsh-web-app 为基础，叠加 soloips 业务插件",
  "dsh": {
    "profile": {
      "bundles": [
        "@deepseek-ai/dsh-base",
        "@deepseek-ai/dsh-web-app",
        "soloips-adapter-dsh",
        "soloips-core",
        "soloips-web",
        "soloips-bundle"
      ]
    }
  },
  "dependencies": {
    "soloips-adapter-dsh": "workspace:*",
    "soloips-core": "workspace:*",
    "soloips-web": "workspace:*",
    "soloips-bundle": "workspace:*"
  }
}
