{
  "name": "soloips",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "SoloIPs Studio — AI 原创 IP 孵化、生产与发行平台（DSH 插件组合交付）",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint --type-aware",
    "typecheck": "tsc -b && tsc -p tsconfig.tests.json",
    "test": "vitest run",
    "test:artifacts": "vitest run --config packages/web/vitest.artifacts.config.ts",
    "test:watch": "vitest",
    "build": "tsc -b && tsdown",
    "pack-artifacts": "node scripts/development/pack-delivery-artifacts.mjs",
    "delivery-lock": "node scripts/development/generate-delivery-lock.mjs",
    "check:delivery-load": "node scripts/development/check-delivery-load.mjs",
    "verify": "node scripts/development/verify-s0.mjs",
    "check:build-repro": "node scripts/development/check-build-reproducibility.mjs",
    "check:m-a-evidence": "node scripts/development/check-m-a-evidence.mjs",
    "check:i18n": "node scripts/development/verify-client-ui-i18n.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-typert-generator": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-typert-protocol": "0.1.6-alpha.2",
    "@types/node": "^22.19.0",
    "oxlint": "^1.0.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.6.0",
    "tsdown": "0.22.2",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "yaml": "^2.9.1"
  }
}
