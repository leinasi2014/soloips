# SoloIPs — 生成物、临时文件与本地数据不入源码

# 依赖
node_modules/
.pnpm-store/

# 构建输出
dist/
build/
out/
*.tsbuildinfo

# 临时执行产物与隔离工作区
.worktrees/
.tmp/
*.tmp

# 本地运行数据（与源码分离；密钥、会话备份不得入库）
data/
runs/
logs/
*.log

# 凭据与本地配置
.env
.env.*
*.credentials.yaml
.credentials.yaml

# 编辑器与系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# 智能体临时探针（不应提交）
.probe-*.cjs
.validate.cjs
