# SoloIPs — 生成物、临时文件与本地数据不入源码

# 依赖
node_modules/
.pnpm-store/

# 构建输出（编译产物不入版本控制；DEV-13：交付位置须可区分候选与生成物）
dist/
build/
out/
lib/
*.tsbuildinfo

# 临时执行产物与隔离工作区
.worktrees/
.tmp/
*.tmp

# 本地运行数据（与源码分离；密钥、会话备份不得入库）
data/
runs/
logs/
*.log

# 凭据与本地配置
.env
.env.*
*.credentials.yaml
.credentials.yaml

# 编辑器与系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# 智能体临时探针（不应提交）
.probe-*.cjs
.validate.cjs

# 本机环境交接与只读核验记录（规程在 docs/operations/）
.artifacts/operations/

# 本机智能体记忆与工作日志（ENV-01：本机记录不入库；含机器路径、内网地址与瞬时进程细节）
.workbuddy-ai/

# 本机智能体工作区（分析草稿与会话记忆，不入库；与 .workbuddy-ai/ 同性质）
.workbuddy/
